/-layer-rule {
	background-effect {
		blur true
		xray false
	}
}

layer-rule {
	match namespace="^swaync-notification-window$"
	match namespace="^swaync-control-center$"
	block-out-from "screencast"
}

layer-rule {
	match namespace="^[as]www-daemonblur$"
	place-within-backdrop true
}

layer-rule {
	match namespace="^waybar$"
	shadow {
		on
		offset x=0 y=10
	}
	background-effect {
		blur true
		xray false
	}
}

layer-rule {
	match namespace="^rofi$"
	geometry-corner-radius 60
	background-effect {
		blur true
		xray false
	}
	shadow {
		on
	}
}
