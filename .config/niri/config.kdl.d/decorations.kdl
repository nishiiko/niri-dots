window-rule {
	geometry-corner-radius 16
	clip-to-geometry true
	draw-border-with-background false
	background-effect {
		blur true
	}
}

window-rule {
	match is-floating=true
	background-effect {
		xray false
	}
}

blur {
	passes 3
	offset 4
	noise 0
}

window-rule {
	exclude app-id=r#"^helium$"# title=r#"YouTube - Helium$"#
	exclude app-id=r#"^helium$"# title=r#"Twitch - Helium$"#
	exclude app-id=r#"^Alacritty$"#
	opacity 0.95
}

recent-windows {
	highlight {
		corner-radius 16
	}
}

layout {
	gaps 16

	shadow {
		on
		softness 5
		spread 0
		offset x=10 y=10
		color "#1A1A1AAA"
		inactive-color "#1A1A1AAA"
	}

	tab-indicator {
		width 4
		length total-proportion=0.7
		position "left"
	}

	border {
		on
		width 6
	}
}
